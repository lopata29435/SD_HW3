{
  "info": {
    "name": "Microservices API",
    "description": "API для тестирования микросервисов заказов и платежей",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/payment/api/accounts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["payment", "api", "accounts"]
            }
          }
        },
        {
          "name": "Deposit Money",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/payment/api/accounts/{{userId}}/deposit?amount={{amount}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["payment", "api", "accounts", "{{userId}}", "deposit"],
              "query": [
                {
                  "key": "amount",
                  "value": "{{amount}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/payment/api/accounts/{{userId}}/balance",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["payment", "api", "accounts", "{{userId}}", "balance"]
            }
          }
        },
        {
          "name": "Check Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/payment/api/accounts/check/{{userId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["payment", "api", "accounts", "check", "{{userId}}"]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/payment/api/health/ping",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["payment", "api", "health", "ping"]
            }
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/order/api/orders?amount={{amount}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["order", "api", "orders"],
              "query": [
                {
                  "key": "amount",
                  "value": "{{amount}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/order/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["order", "api", "orders"]
            }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/order/api/orders/{{orderId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["order", "api", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/order/api/health/ping",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["order", "api", "health", "ping"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "amount",
      "value": "100.00",
      "type": "string"
    }
  ]
}